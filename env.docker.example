# Setelah "composer create-project" jalan, Laravel bikin backend/.env otomatis.
# Timpa/ubah baris-baris di bawah ini di backend/.env supaya nyambung ke service Docker.

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=azatech_order
DB_USERNAME=azatech
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@azatech-order.test"
MAIL_FROM_NAME="${APP_NAME}"
